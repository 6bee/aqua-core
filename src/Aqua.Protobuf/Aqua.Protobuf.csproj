<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <PackageId>aqua-core-protobuf</PackageId>
    <PackageTags>aqua-core;protobuf;google-protobuf;proto3;binary;serialization</PackageTags>
    <Description>Provides schema-first Google.Protobuf serialization for Aqua types.</Description>
    <NoWarn>$(NoWarn);S1135</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aqua.Protobuf.Tests, " />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aqua\Aqua.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\aqua.proto" ProtoRoot="Protos" GrpcServices="None" Access="Public" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Google.Protobuf" Global="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Protos\**\*.proto" Pack="true" PackagePath="content/protos/%(RecursiveDir)" />
    <None Include="BuildTransitive\**" Pack="true" PackagePath="buildTransitive/%(RecursiveDir)" />
  </ItemGroup>

</Project>
