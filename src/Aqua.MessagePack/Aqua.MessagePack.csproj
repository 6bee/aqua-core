<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <PackageId>aqua-core-messagepack</PackageId>
    <PackageTags>aqua-core;messagepack;msgpack;binary;serialization</PackageTags>
    <Description>Provides MessagePack serialization for Aqua types.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aqua.MessagePack.Tests, " />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aqua\Aqua.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Aqua.Dynamic" Global="true" />
    <Using Include="Aqua.TypeSystem" Global="true" />
    <Using Include="MessagePack" Global="true" />
    <Using Include="MessagePack.Formatters" Global="true" />
  </ItemGroup>

</Project>
